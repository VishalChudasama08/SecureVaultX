# ============================================================================
# SecureVaultX — root .gitignore (backend + Flutter frontend)
# ============================================================================

# ---- Secrets: never commit these -------------------------------------------
.env
*.env
!.env.example
securevaultx-spring-boot/data/
**/securevaultx-master-key*

# ============================================================================
# Backend (Maven / Spring Boot / Java)
# ============================================================================
securevaultx-spring-boot/target/
securevaultx-spring-boot/data/
!**/src/main/**/target/
!**/src/test/**/target/

# IDEs
.idea/
*.iws
*.iml
*.ipr
.vscode/
.classpath
.project
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Logs
*.log

# ============================================================================
# Frontend (Flutter / Dart)
# ============================================================================
SecureVaultX_UI/.dart_tool/
SecureVaultX_UI/.flutter-plugins
SecureVaultX_UI/.flutter-plugins-dependencies
SecureVaultX_UI/.packages
SecureVaultX_UI/.pub-cache/
SecureVaultX_UI/.pub/
SecureVaultX_UI/build/
SecureVaultX_UI/*.iml
SecureVaultX_UI/.idea/

# Platform build output (generated by `flutter create`; regenerate with
# `flutter create .` if you need to build for a platform not already present)
SecureVaultX_UI/android/.gradle/
SecureVaultX_UI/android/local.properties
SecureVaultX_UI/android/**/GeneratedPluginRegistrant.java
SecureVaultX_UI/ios/Flutter/.last_build_id
SecureVaultX_UI/ios/Pods/
SecureVaultX_UI/ios/.symlinks/
SecureVaultX_UI/windows/flutter/generated_plugin_registrant.*
SecureVaultX_UI/linux/flutter/generated_plugin_registrant.*
SecureVaultX_UI/macos/Flutter/GeneratedPluginRegistrant.*
SecureVaultX_UI/web/

# Coverage
SecureVaultX_UI/coverage/

# ============================================================================
# OS
# ============================================================================
.DS_Store
Thumbs.db
