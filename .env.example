# ============================================================================
# SecureVaultX — example environment configuration
#
# Copy this file to `.env` (same directory) for local Docker/compose use, or
# export these as real environment variables before starting the backend.
# NEVER commit an actual .env file — it is already excluded in .gitignore.
# ============================================================================

# ---- Database ---------------------------------------------------------------
# The backend connects with a standard MySQL JDBC URL. Flyway creates the
# schema automatically on first startup (see src/main/resources/db/migration).
SECUREVAULTX_DB_URL=jdbc:mysql://localhost:3306/securevaultx?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SECUREVAULTX_DB_USER=root
SECUREVAULTX_DB_PASSWORD=change-me

# ---- Master key (REQUIRED) ---------------------------------------------------
# The application refuses to start without a valid master key. Generate one
# real random 256-bit key per environment — NEVER reuse the example below and
# NEVER commit a real one:
#
#   openssl rand -base64 32
#
# WARNING: if you change or lose this value, every file previously stored in
# the vault or downloaded as .enc becomes permanently undecryptable. Back it
# up somewhere safe (a password manager / secrets vault), separately from
# this repository and separately from the database.
SECUREVAULTX_MASTER_KEY=REPLACE_WITH_output_of__openssl_rand_-base64_32
SECUREVAULTX_MASTER_KEY_ID=k1

# ---- Storage policy -----------------------------------------------------------
# Where encrypted vault files are written on disk (never served as a static
# web resource — all access goes through authenticated controllers).
SECUREVAULTX_STORAGE_ROOT=./data

# Product policy: largest file the "Store in Secure Vault" mode will accept.
# This is NOT an AES limitation — "Encrypt & Download" works for any size up
# to SECUREVAULTX_MAX_UPLOAD_SIZE below.
SECUREVAULTX_MAX_VAULT_FILE_SIZE=5MB

# Operational safety limit for any single upload (applies to both vault
# storage and Encrypt & Download / decrypt).
SECUREVAULTX_MAX_UPLOAD_SIZE=2GB

# ---- CORS ----------------------------------------------------------------------
# Only needed if you serve a browser-based client (e.g. Flutter Web) from a
# different origin than the backend. Comma-separated exact origins, e.g.:
#   SECUREVAULTX_CORS_ORIGINS=http://localhost:5000,https://vault.example.com
# Native Flutter apps (Android/Windows/iOS/macOS/Linux) ignore CORS entirely;
# leave this empty unless you build for the web.
SECUREVAULTX_CORS_ORIGINS=

# ---- Session cookie --------------------------------------------------------------
# Set to true when the backend is served over HTTPS (always in production).
# Must stay false for plain-HTTP local development, or browsers/HTTP clients
# will silently refuse to send the cookie back.
SECUREVAULTX_COOKIE_SECURE=false

# ---- Server ----------------------------------------------------------------------
SECUREVAULTX_PORT=8080
